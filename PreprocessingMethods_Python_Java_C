package org.changbal.pre;

import edu.emory.mathcs.jtransforms.fft.DoubleFFT_1D;
import java.util.Arrays;

public final class FGP {
  private FGP() {}

  public static <T> T transform(
      T instance,
      Signalize<T> signalize,
      Discretize<T> discretize,
      Guard<T> guard,
      Config cfg
  ) {
    // (1) Domain-specific encoding
    double[] s = signalize.apply(instance);
    int N = s.length;

    // (2) Forward DFT (real -> full complex)
    DoubleFFT_1D fft = new DoubleFFT_1D(N);
    double[] S = new double[2 * N];
    Arrays.fill(S, 0.0);
    System.arraycopy(s, 0, S, 0, N);
    fft.realForwardFull(S); // Output: interleaved complex [Re0, Im0, Re1, Im1, ...]

    // (3) Guided mask in frequency domain (user policy)
    guidedMaskInPlace(S, cfg.band, cfg.fLo, cfg.fHi, cfg.softMask);

    // (4) Inverse transform
    //    JTransforms expects complexInverse(data, scale). If scale=true, it
    //    divides by N internally. This must match your cross-language policy.
    fft.complexInverse(S, true);

    // Convert back to a real signal for discretization (drop imaginary part).
    double[] x = new double[N];
    for (int k = 0; k < N; k++) x[k] = S[2 * k]; // take Re component

    // (5) Discretize & remap to a valid instance
    T out = discretize.apply(x);

    // (6) Guard combinatorial semantics
    if (!guard.ok(out)) {
      throw new IllegalArgumentException("Combinatorial semantics violated by FGP output.");
    }
    return out;
  }

  private static void guidedMaskInPlace(double[] S, String band,
                                        double fLo, double fHi, boolean soft) {
