// Laplace-Guided Preprocessing (LGP) — reference stub (1D illustration).
//
// Idea:
// - Apply discrete diffusion using a 1D Laplacian. For graphs/hypergraphs,
//   replace with the appropriate Laplacian operator on the topology.
//
// Caution:
// - Excessive smoothing may destroy discrete semantics; guard() must pass.
// -----------------------------------------------------------------------------
package org.changbal.pre;

public final class LGP {
  private LGP() {}

  public static <T> T transform(
      T instance,
      Signalize<T> signalize,
      Discretize<T> discretize,
      Guard<T> guard,
      Config cfg
  ) {
    double[] x = signalize.apply(instance).clone();
    int N = x.length;

    for (int it = 0; it < cfg.steps; it++) {
      double[] next = new double[N];
      for (int k = 0; k < N; k++) {
        double prev = x[(k - 1 + N) % N];
        double curr = x[k];
        double succ = x[(k + 1) % N];
        double lap = prev - 2.0 * curr + succ;  // 1D Laplacian
        next[k] = curr + cfg.alpha * lap;
      }
      x = next;
    }

    T out = discretize.apply(x);
    if (!guard.ok(out)) {
      throw new IllegalArgumentException("Combinatorial semantics violated by LGP output.");
    }
    return out;
  }
}




