#include <math.h>
#include <stdlib.h>

double stabilityMetric(double closure, double closureP) {
    /* Optional: introduce deterministic pseudo-noise for variability testing */
    return 1.0 - fabs(closure - closureP);
}

double evaluate_cjm_hodge(double* signal, int N, double epsilon) {

    double gradNorm = 0.0;
    for (int i = 1; i < N; i++) {
        double g = signal[i] - signal[i-1];
        gradNorm += g*g;
    }
    gradNorm = sqrt(gradNorm);

    double closure = 1.0 / (1.0 + gradNorm);

    double mean = 0.0;
    for (int i = 0; i < N; i++) mean += signal[i];
    mean /= N;

    double energy = 0.0;
    for (int i = 0; i < N; i++) {
        double d = signal[i] - mean;
        energy += d*d;
    }
    double energyPeak = exp(-energy / epsilon);

    double closureP = closure * (1.0 - 0.01);  // lightweight perturbation proxy
    double stability = stabilityMetric(closure, closureP);

    return closure * stability * energyPeak;
}
