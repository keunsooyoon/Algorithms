import java.util.Random;

public class CJMHodgeStub {

    public static class Result {
        public double admissibility;
        public double closure;
        public double stability;
        public double coherence;
        public double energyPeak;
    }

    public static Result evaluate(double[] signal, double epsilon, double noiseScale, long seed) {
        Result r = new Result();
        Random rng = new Random(seed);

        double gradNorm = 0.0;
        for (int i = 1; i < signal.length; i++) {
            double g = signal[i] - signal[i - 1];
            gradNorm += g * g;
        }
        gradNorm = Math.sqrt(gradNorm);

        r.closure = 1.0 / (1.0 + gradNorm);

        double mean = 0.0;
        for (double v : signal) mean += v;
        mean /= signal.length;

        double energy = 0.0;
        for (double v : signal) {
            double d = v - mean;
            energy += d * d;
        }
        r.energyPeak = Math.exp(-energy / epsilon);

        double coherence = 0.0;
        for (int i = 1; i < signal.length; i++) {
            coherence += Math.abs(signal[i] - signal[i - 1]);
        }
        r.coherence = coherence / signal.length;

        double[] perturbed = signal.clone();
        for (int i = 0; i < perturbed.length; i++) {
            perturbed[i] += rng.nextGaussian() * noiseScale;
        }

        double gradNormP = 0.0;
        for (int i = 1; i < perturbed.length; i++) {
            double g = perturbed[i] - perturbed[i - 1];
            gradNormP += g * g;
        }
        gradNormP = Math.sqrt(gradNormP);

        double closureP = 1.0 / (1.0 + gradNormP);
        r.stability = 1.0 - Math.abs(r.closure - closureP);

        r.admissibility = r.closure * r.stability * r.energyPeak / (1.0 + r.coherence);
        return r;
    }
}


